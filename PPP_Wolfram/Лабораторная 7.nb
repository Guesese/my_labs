Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "*", "Pi", "*", "sigma1", "*", "sigma2", "*", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", 
        RowBox[{"cor", "^", "2"}]}], "]"}]}]], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"-", "1"}], 
       RowBox[{"2", "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"cor", "^", "2"}]}], ")"}]}]], "*", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", "a1"}], ")"}], "^", "2"}], 
         RowBox[{"sigma1", "^", "2"}]], "+", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"y", "-", "a2"}], ")"}], "^", "2"}], 
         RowBox[{"sigma2", "^", "2"}]], "-", 
        RowBox[{"2", "*", "cor", "*", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "-", "a1"}], ")"}], "*", 
           RowBox[{"(", 
            RowBox[{"y", "-", "a2"}], ")"}]}], 
          RowBox[{"sigma1", "*", "sigma2"}]]}]}], ")"}]}], "]"}]}]}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"\"\<\:041f\:0440\:043e\:0432\:0435\:0440\:043a\:0430:\>\"", " ", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "y"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
      RowBox[{"Assumptions", "\[Rule]", 
       RowBox[{"0", "<", "cor", "<", "1"}]}]}], "]"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", ":=", 
   RowBox[{"1", "-", "p", "-", "q"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", ":=", 
   RowBox[{"n", "-", "k", "-", "l"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"pr", "[", 
     RowBox[{"k_", ",", "l_", ",", "m_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Multinomial", "[", 
      RowBox[{"k", ",", "l", ",", "m"}], "]"}], " ", 
     SuperscriptBox["p", "k"], 
     SuperscriptBox["q", "l"], 
     SuperscriptBox["r", "m"]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"n", "=", 
    RowBox[{
     RowBox[{"5", "\[IndentingNewLine]", "meanK"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"k", "-", 
             RowBox[{"n", "*", "p"}]}], ")"}], "*", 
           RowBox[{"pr", "[", 
            RowBox[{"k", ",", "l", ",", "m"}], "]"}]}], "//", "N"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", "0", ",", 
           RowBox[{"n", "-", "k"}]}], "}"}]}], "]"}], "//", 
       RowBox[{"Simplify", "\[IndentingNewLine]", "meanL"}]}], "=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"l", "-", 
             RowBox[{"n", "*", "q"}]}], ")"}], "*", 
           RowBox[{"pr", "[", 
            RowBox[{"k", ",", "l", ",", "m"}], "]"}]}], "//", "N"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", "0", ",", 
           RowBox[{"n", "-", "k"}]}], "}"}]}], "]"}], "//", 
       "Simplify"}]}]}]}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "=", 
   RowBox[{"1", "/", "2"}]}], ";", 
  RowBox[{"q", "=", 
   RowBox[{"1", "/", "3"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tab", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", "l", ",", 
       RowBox[{
        RowBox[{"pr", "[", 
         RowBox[{"k", ",", "l", ",", "m"}], "]"}], "//", "N"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "n"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "0", ",", 
       RowBox[{"n", "-", "k"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fig1", "=", 
   RowBox[{"ListPointPlot3D", "[", 
    RowBox[{"tab", ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"meanK", "=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"k", "-", 
          RowBox[{"n", "*", "p"}]}], ")"}], "*", 
        RowBox[{"pr", "[", 
         RowBox[{"k", ",", "l", ",", "m"}], "]"}]}], "//", "N"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "0", ",", 
        RowBox[{"n", "-", "k"}]}], "}"}]}], "]"}]}], ";"}], 
  RowBox[{
  "(*", "\:041f\:0440\:043e\:0432\:0435\:0440\:043a\:0430", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"meanL", "=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"l", "-", 
          RowBox[{"n", "*", "q"}]}], ")"}], "*", 
        RowBox[{"pr", "[", 
         RowBox[{"k", ",", "l", ",", "m"}], "]"}]}], "//", "N"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "0", ",", 
        RowBox[{"n", "-", "k"}]}], "}"}]}], "]"}]}], ";"}], 
  RowBox[{"(*", "\:041f\:0440\:043e\:0432\:0435\:0440\:043a\:0430", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a1", "=", 
   RowBox[{"n", "*", "p"}]}], ";", 
  RowBox[{"a2", "=", 
   RowBox[{"n", "*", "q"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"varKK", "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"k", "-", 
