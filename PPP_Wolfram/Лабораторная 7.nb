Cell[BoxData[{
 RowBox[{
  RowBox[{"meanw", "[", "z0__", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", ",", "z"}], "}"}], ",", 
    RowBox[{
     RowBox[{"Print", "[", "z0", "]"}], ";", 
     RowBox[{"z", "=", 
      RowBox[{"List", "[", "z0", "]"}]}], " ", ";", 
     RowBox[{"Print", "[", "z", "]"}], ";", 
     RowBox[{"s", "=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"z", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "/", "i"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "z", "]"}]}], "}"}]}], "]"}], "/", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"1", "/", "i"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "z", "]"}]}], "}"}]}], "]"}]}]}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
