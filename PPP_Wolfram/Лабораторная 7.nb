   3.63706446065625*^9, 3.637064506015625*^9}, {3.637064817703125*^9, 
   3.63706481996875*^9}, 3.637124059671875*^9, {3.63712411425*^9, 
   3.637124182171875*^9}, {3.637389452390625*^9, 3.6373894779375*^9}, 
   3.639397447703125*^9, {3.6449043571221485`*^9, 3.644904358401351*^9}, {
   3.6449043953266163`*^9, 3.644904398446622*^9}, {3.66107131529342*^9, 
   3.661071318241825*^9}, {3.6610713546552887`*^9, 3.66107135563809*^9}, {
   3.8153033428512044`*^9, 3.815303387155217*^9}, 3.817819668418782*^9, 
   3.908867595708688*^9},ExpressionUUID->"881b1071-1f94-44db-96ce-\
dd9b15382a89"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "f", ",", "pr", ",", "p", ",", "q", ",", "r", ",", "n", ",", "k", ",", 
      "l", ",", "m", ",", "a1", ",", "a2", ",", "varK", ",", "varL", ",", 
      "covKL", ",", "sigma1", ",", "sigma2", ",", "cor", ",", "pts", ",", 
      "plot1", ",", "plot2"}], "]"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p", "=", 
     RowBox[{"1", "/", "2"}]}], ";", 
    RowBox[{"q", "=", 
     RowBox[{"1", "/", "3"}]}], ";", 
    RowBox[{"n", "=", "50"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r", ":=", 
     RowBox[{"1", "-", "p", "-", "q"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"m", ":=", 
     RowBox[{"n", "-", "k", "-", "l"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pr", "[", 
      RowBox[{"k_", ",", "l_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Multinomial", "[", 
       RowBox[{"k", ",", "l", ",", "m"}], "]"}], "*", 
      RowBox[{"p", "^", "k"}], "*", 
      RowBox[{"q", "^", "l"}], "*", 
      RowBox[{"r", "^", "m"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "*", "Pi", "*", "sigma1", "*", "sigma2", "*", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"1", "-", 
         RowBox[{"cor", "^", "2"}]}], "]"}]}]], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"-", "1"}], 
        RowBox[{"2", "*", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"cor", "^", "2"}]}], ")"}]}]], "*", 
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "-", "a1"}], ")"}], "^", "2"}], 
          RowBox[{"sigma1", "^", "2"}]], "+", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"y", "-", "a2"}], ")"}], "^", "2"}], 
          RowBox[{"sigma2", "^", "2"}]], "-", 
         RowBox[{"2", "*", "cor", "*", 
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "a1"}], ")"}], "*", 
            RowBox[{"(", 
             RowBox[{"y", "-", "a2"}], ")"}]}], 
           RowBox[{"sigma1", "*", "sigma2"}]]}]}], ")"}]}], "]"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"pts", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"k", ",", "l", ",", 
           RowBox[{"N", "[", 
            RowBox[{"pr", "[", 
             RowBox[{"k", ",", "l"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", "0", ",", 
           RowBox[{"n", "-", "k"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"a1", "=", 
     RowBox[{"n", "*", "p"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a2", "=", 
     RowBox[{"n", "*", "q"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"meanCheckK", "=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"k", "-", "a1"}], ")"}], "*", 
       RowBox[{"N", "[", 
        RowBox[{"pr", "[", 
         RowBox[{"k", ",", "l"}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "0", ",", 
        RowBox[{"n", "-", "k"}]}], "}"}]}], "]"}]}], "\n", 
   RowBox[{"meanCheckL", "=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"l", "-", "a2"}], ")"}], "*", 
       RowBox[{"N", "[", 
        RowBox[{"pr", "[", 
         RowBox[{"k", ",", "l"}], "]"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"l", ",", "0", ",", 
        RowBox[{"n", "-", "k"}]}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"varK", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"k", "-", "a1"}], ")"}], "^", "2"}], "*", 
        RowBox[{"N", "[", 
         RowBox[{"pr", "[", 
          RowBox[{"k", ",", "l"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "n"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "0", ",", 
         RowBox[{"n", "-", "k"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"varL", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"l", "-", "a2"}], ")"}], "^", "2"}], "*", 
        RowBox[{"N", "[", 
         RowBox[{"pr", "[", 
          RowBox[{"k", ",", "l"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "n"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "0", ",", 
         RowBox[{"n", "-", "k"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"covKL", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"k", "-", "a1"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"l", "-", "a2"}], ")"}], "*", 
        RowBox[{"N", "[", 
         RowBox[{"pr", "[", 
          RowBox[{"k", ",", "l"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", "n"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l", ",", "0", ",", 
         RowBox[{"n", "-", "k"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"sigma1", "=", 
     RowBox[{"Sqrt", "[", "varK", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sigma2", "=", 
     RowBox[{"Sqrt", "[", "varL", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cor", "=", 
     RowBox[{"covKL", "/", 
      RowBox[{"(", 
       RowBox[{"sigma1", "*", "sigma2"}], ")"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plot1", "=", 
     RowBox[{"ListPointPlot3D", "[", 
      RowBox[{"pts", ",", 
       RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"plot2", "=", 
     RowBox[{"Plot3D", "[", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "n"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "n"}], "}"}], ",", 
       RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"Opacity", "[", "0.6", "]"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"plot1", ",", "plot2"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.004087594319374*^9, 4.0040876450163784`*^9}},
 CellLabel->
  "In[212]:=",ExpressionUUID->"f5ee09ff-a95a-4556-bd15-eb0ef430a11a"],

